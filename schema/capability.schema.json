{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productgraph.io/schema/capability.schema.json",
  "$ref": "#/$defs/CapabilityCatalog",
  "$defs": {
    "Capability": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "CapabilityCatalog": {
      "properties": {
        "metadata": {
          "$ref": "#/$defs/CatalogMetadata"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "metadata",
        "capabilities"
      ]
    },
    "CatalogMetadata": {
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "generated": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "title"
      ]
    },
    "DocumentationLink": {
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "label",
        "url"
      ]
    },
    "Feature": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "adminPath": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "documentation": {
          "items": {
            "$ref": "#/$defs/DocumentationLink"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    }
  }
}